# Copy to .env.local. Only VITE_-prefixed vars reach the browser bundle.
# The Supabase ANON key is safe for the client; the SERVICE key is NOT and must
# never appear here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_BASE_URL=http://localhost:8000/api
