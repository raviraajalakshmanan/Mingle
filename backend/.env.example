# Copy to .env and fill in. NEVER commit the real .env.
ENVIRONMENT=dev

# Supabase — from your project's API settings
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key          # server-side only!
SUPABASE_JWT_SECRET=your-jwt-secret                 # Settings → API → JWT Secret

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Public URL of the deployed frontend (used to build invite/result links)
FRONTEND_BASE_URL=http://localhost:5173
